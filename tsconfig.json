{
  "compilerOptions": {
    "declaration": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./lib",
    "strict": true,
    "experimentalDecorators": true,
    "rootDir": "./src",
    "target": "esnext",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"],
  "typedocOptions": {
    "name": "Detritus Socket Client",
    "out": "./docs",
    "entryPoints": [
      "./src"
    ]
  }
}